# Backend environment. Copy to .env for local development (`npm run dev`), and add
# the same keys in your host's settings for deployments (e.g. Vercel -> Project ->
# Settings -> Environment Variables). Never commit real keys: .env is git-ignored.
# These are server secrets. None of them belong in the frontend.

# Port for the local API server.
PORT=3001

# The frontend's public address, e.g. https://svaraa.ai. Stripe sends buyers back
# here after paying, and it is always allowed to call the API.
SITE_URL=

# Other frontend origins allowed to call the API from the browser (CORS), comma-separated.
# Local Vite dev servers are listed here; add preview deployments if you use them.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Stripe secret key: sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint https://<your-backend>/api/stripe-webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.async_payment_failed, checkout.session.expired,
#  refund.created, refund.updated, refund.failed).
STRIPE_WEBHOOK_SECRET=

# Optional: every paid reservation is also POSTed here as JSON (Google Sheet script, CRM, your API).
RESERVATIONS_WEBHOOK_URL=

# Supabase (Postgres) database where every order is stored.
# Supabase -> Project Settings -> Data API: copy the Project URL.
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys: the secret server key (service_role, or a new sb_secret_... key).
# It bypasses Row Level Security, so it must stay on the backend.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string (Supabase -> Connect), postgresql://...
# Not used by the app; only handy for running migrations from your machine.
SUPABASE_DB_URL=
