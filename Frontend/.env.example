# Frontend environment. Everything starting with VITE_ is built into the public
# JavaScript, so only put public values here: never keys or secrets (those live
# in Backend/.env). For deployments, set the same keys in your host's settings.

# Address of the backend API, e.g. https://api.svaraa.ai (no trailing slash).
# Leave empty in development: Vite then forwards /api to API_PROXY_TARGET.
VITE_API_URL=

# Development only: where the local backend runs (not exposed to the browser).
API_PROXY_TARGET=http://localhost:3001
