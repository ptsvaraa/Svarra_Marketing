# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for deployments.
# Never commit real keys. .env and .env.* are git-ignored.

# Stripe secret key: sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint https://<your-site>/api/stripe-webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=

# Optional: every paid reservation is also POSTed here as JSON (Google Sheet script, CRM, your API).
RESERVATIONS_WEBHOOK_URL=

# Optional: your public site address, used for Stripe's return links, e.g. https://svaraa.ai
SITE_URL=
