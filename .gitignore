# Dependencies: each app installs its own (the host runs `npm install` on deploy).
# Committing them ships Windows-only binaries that break the Linux build.
node_modules/

# Build output, rebuilt on every deploy.
dist/

# Environment files hold keys and local settings. Only the examples are committed.
.env
.env.*
!.env.example

# Local tooling and editor files
.claude/
.vercel/
*.log
.DS_Store
Thumbs.db
